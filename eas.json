{
  "cli": {
    "version": ">= 16.30.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CUSTOM_NODE_ENV": "development",
        "EXPO_PUBLIC_CONVEX_URL": "https://flippant-ocelot-772.convex.cloud",
        "EXPO_PUBLIC_APP_URL": "cooture://",
        "EXPO_PUBLIC_AUTH_URL": "cooture://"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CUSTOM_NODE_ENV": "production",
        "EXPO_PUBLIC_CONVEX_URL": "https://flippant-ocelot-772.convex.cloud",
        "EXPO_PUBLIC_APP_URL": "cooture://",
        "EXPO_PUBLIC_AUTH_URL": "cooture://"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CUSTOM_NODE_ENV": "production",
        "EXPO_PUBLIC_CONVEX_URL": "https://flippant-ocelot-772.convex.cloud",
        "EXPO_PUBLIC_APP_URL": "cooture://",
        "EXPO_PUBLIC_AUTH_URL": "cooture://"
      }
    }
  },
  "submit": {
    "production": {}
  }
}