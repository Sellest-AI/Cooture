{
  "expo": {
    "name": "Cooture",
    "slug": "cooture",
    "version": "0.9.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cooture",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.cooture.app",
      "associatedDomains": [
        "applinks:cooture.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CBFF1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "package": "com.cooture.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "com.android.vending.BILLING"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "cooture.app",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "cooture.app",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "cooture.app",
              "pathPrefix": "/o"
            },
            {
              "scheme": "https",
              "host": "cooture.app",
              "pathPrefix": "/i"
            },
            {
              "scheme": "https",
              "host": "cooture.app",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "cooture.app",
              "pathPrefix": "/link"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#080808",
          "dark": {
            "backgroundColor": "#080808"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#CBFF1F"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Murays-Regular.otf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Murays",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Murays-Regular.otf",
                    "weight": 600,
                    "style": "normal"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f31d9764-3c8b-402d-9458-91e02bddf9d9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f31d9764-3c8b-402d-9458-91e02bddf9d9",
      "enableBsdiffPatchSupport": true
    }
  }
}